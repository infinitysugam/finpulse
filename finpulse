#!/bin/sh
# Start the FinPulse Django backend and Vite frontend dev server

# Project root (where this script lives)
PROJECT_DIR="/home/infinity/Documents/own/finpulse"
cd "$PROJECT_DIR" || exit 1

# Activate the Python virtual environment
. venv/bin/activate

# Start the Django backend in the background
python manage.py runserver &
DJANGO_PID=$!

# Stop the Django process when this script exits
trap 'kill $DJANGO_PID 2>/dev/null; wait $DJANGO_PID 2>/dev/null' INT TERM EXIT

# Start the frontend dev server in the foreground
cd frontend
npm run dev
